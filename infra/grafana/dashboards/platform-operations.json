{
  "title": "AI Stock Platform Operations",
  "uid": "stock-platform-operations",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "30s",
  "panels": [
    {"id": 1, "title": "API success rate", "type": "timeseries", "targets": [{"expr": "sum(rate(platform_service_requests_total{status=~\"2..\"}[5m])) / clamp_min(sum(rate(platform_service_requests_total[5m])), 1)"}]},
    {"id": 2, "title": "Provider failures", "type": "timeseries", "targets": [{"expr": "sum by (provider) (rate(platform_provider_calls_total{outcome!=\"ok\"}[5m]))"}]},
    {"id": 3, "title": "Tool failures", "type": "timeseries", "targets": [{"expr": "sum by (tool) (rate(platform_tool_calls_total{outcome!=\"completed\"}[5m]))"}]},
    {"id": 4, "title": "Graph failures", "type": "timeseries", "targets": [{"expr": "sum by (graph,node) (rate(platform_graph_nodes_total{outcome!=\"completed\"}[5m]))"}]},
    {"id": 5, "title": "Alert failures", "type": "timeseries", "targets": [{"expr": "sum by (rule) (rate(platform_alerts_total{outcome=~\"failed|degraded\"}[5m]))"}]},
    {"id": 6, "title": "Queue depth", "type": "timeseries", "targets": [{"expr": "platform_queue_depth"}]},
    {"id": 7, "title": "Cost", "type": "timeseries", "targets": [{"expr": "sum by (kind) (rate(platform_cost_total[5m]))"}]},
    {"id": 8, "title": "Evaluation gates", "type": "stat", "targets": [{"expr": "sum by (outcome) (platform_evaluation_runs_total)"}]}
  ]
}
